{
  "name": "Lucky Reels",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "postAttachCommand": {
    "server": "npm start"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Lucky Reels",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
